{
  "name": "pos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Point of Sale (POS) REST API",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.57.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/http",
    "test:docs": "vitest run tests/docs",
    "test:spec": "redocly lint --config .redocly.yaml docs/openapi.yaml",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts && drizzle-kit generate --config=drizzle.config.postgres.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:reset": "tsx src/infrastructure/database/reset.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "docker:up": "tsx src/infrastructure/database/compose-up.ts",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:stack": "docker compose up --build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
