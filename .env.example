# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — one URL selects the engine:
#   SQLite:     DATABASE_URL=file:./dev.db
#   PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pos_dev
DATABASE_URL=file:./dev.db

# Test-only PostgreSQL target used by integration tests.
# Required in CI (tests fail when unset there).
TEST_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/pos_test

# OAuth 2.0 / OIDC (Phase 6) — the three core values must be set together.
# Empty values count as unset (auth fails closed until configured).
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Optional: expected `aud` claim of the ID token (defaults to the client id).
OAUTH_AUDIENCE=
# Registered callback URL. Derived from the request when unset (development).
OAUTH_REDIRECT_URI=

# Session cookie signing secret (generate with: openssl rand -base64 48)
COOKIE_SECRET=

# Hardening (Phase 10) — optional, defaults shown.
# Requests per window per client IP (window = 60s). /health is never limited.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated CORS allowlist. Unset = no CORS headers emitted.
CORS_ORIGINS=
# Double-submit CSRF check for cookie-authenticated writes: true | false.
CSRF_PROTECTION=true
