# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — one URL selects the engine:
#   SQLite:     DATABASE_URL=file:./dev.db
#   PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdv_dev
DATABASE_URL=file:./dev.db

# Test-only PostgreSQL target used by integration tests.
# Required in CI (tests fail when unset there).
TEST_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdv_test

# OAuth 2.0 / OIDC (Phase 6)
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Session cookie signing secret (generate with: openssl rand -base64 48)
COOKIE_SECRET=
